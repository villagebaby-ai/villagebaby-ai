---
// PLAYBOOK 필수 — 본문 FAQ 6~10개 + JSON-LD FAQPage 1:1 매칭
// 펼친 상태가 기본
export interface Props {
  items: Array<{ q: string; a: string }>;
}
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" aria-labelledby="faq-heading">
    <h2 id="faq-heading">자주 묻는 질문</h2>
    <dl>
      {items.map((it, i) => (
        <div class="faq-item">
          <dt><span class="faq-num">{String(i + 1).padStart(2, '0')}</span>{it.q}</dt>
          <dd>{it.a}</dd>
        </div>
      ))}
    </dl>
  </section>
)}

<style>
  .faq { margin: 48px 0 24px; }
  .faq h2 {
    font-size: 20px;
    font-weight: 800;
    color: var(--gray-900);
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }
  .faq dl { display: block; }
  .faq-item {
    padding: 18px 0;
    border-top: 1px solid var(--gray-200);
  }
  .faq-item:last-child { border-bottom: 1px solid var(--gray-200); }
  .faq-item dt {
    display: flex;
    gap: 14px;
    font-size: 15.5px;
    font-weight: 700;
    color: var(--gray-900);
    margin-bottom: 8px;
    line-height: 1.5;
  }
  .faq-num {
    flex-shrink: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    font-weight: 600;
    color: var(--blue-700);
    padding-top: 1px;
  }
  .faq-item dd {
    font-size: 14px;
    color: var(--gray-700);
    line-height: 1.75;
    margin: 0 0 0 34px;
  }
</style>
