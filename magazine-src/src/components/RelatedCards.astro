---
// PLAYBOOK 필수 — 관련 글 4개 카드
// related는 slug 배열 (예: ['pregnancy/golden-time', 'pregnancy/nt-result'])
import { getCollection } from 'astro:content';
import CoverImage from './CoverImage.astro';

export interface Props {
  slugs: string[];
  fallbackTitle?: string;
}
const { slugs, fallbackTitle = '함께 보면 좋은 글' } = Astro.props;

const all = await getCollection('articles', ({ data }) => !data.draft);
const map = new Map(all.map((a) => [a.slug, a]));
const items = slugs.map((s) => map.get(s)).filter(Boolean) as typeof all;

const pillarName: Record<string, string> = {
  pregnancy: '임신', newborn: '신생아', toddler: '영유아',
  school: '학동기', teen: '청소년기', case: '케이스',
};
---
{items.length > 0 && (
  <section class="related">
    <div class="related-head">
      <h2>{fallbackTitle}</h2>
      <a class="related-all" href="/magazine/">전체보기 →</a>
    </div>
    <div class="related-grid">
      {items.map((a) => (
        <a class="related-card" href={`/magazine/${a!.slug}/`}>
          <CoverImage cover={a!.data.cover} title={a!.data.title} pillar={a!.data.pillar} aspect="1-1" />
          <p class="related-pillar">{pillarName[a!.data.pillar] ?? a!.data.pillar}</p>
          <p class="related-title">{a!.data.title}</p>
          <p class="related-desc">{a!.data.description}</p>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related { margin: 48px 0 24px; }
  .related-head {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 18px;
  }
  .related h2 {
    font-size: 20px;
    font-weight: 800;
    color: var(--gray-900);
    letter-spacing: -0.01em;
  }
  .related-all { font-size: 13px; font-weight: 600; color: var(--gray-500); }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .related-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .related-card :global(.cover) { margin-bottom: 12px; border-radius: 12px; }
  .related-pillar {
    font-size: 11px;
    color: var(--blue-700);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .related-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--gray-900);
    line-height: 1.45;
    margin-bottom: 6px;
  }
  .related-desc {
    font-size: 13px;
    color: var(--gray-600);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 640px) {
    .related-grid { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
