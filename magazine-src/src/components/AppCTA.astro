---
// 앱 CTA — 문구를 slug 해시로 골라 글마다 다르게 한다.
// (같은 CTA 문단이 여러 글에 복붙되면 본문 중복률이 올라 색인에서 불리해진다 — 2026-08-05 실측)
export interface Props { title: string; slug: string; pillar?: string; }
const { title, slug, pillar = 'newborn' } = Astro.props;

const APP_LINK = 'https://app.babybilly.app/qm6eya8';

const HEAD_BABY = [
  '아기 기록, 부부가 같이 남겨요', '{T} 겪는 지금, 기록해두면 병원에서 편해요',
  '수유·수면·기저귀 한 화면에서', '아기 성장 기록을 매일 한 줄씩',
  '예방접종 일정 놓치지 않게', '오늘 아기 하루를 남겨두세요',
  '밤중 수유 기록도 자동으로 정리돼요', '아기 사진과 기록을 한곳에',
];
const HEAD_PREG = [
  '내 주차엔 뭐가 정상일까, 매일 알려드려요', '{T}, 혼자 검색하지 않아도 되게',
  '예정일만 넣으면 오늘이 몇 주인지 자동으로', '지금이 몇 주인지, 뭘 준비할 때인지',
  '검사 시기 놓치지 않게 미리 알려드려요', '오늘 아기는 얼마나 컸을까요',
  '임신 주차별로 매일 하나씩 챙겨드려요', '같은 주차 엄마들은 어떻게 하고 있을까',
];
const BODY1_BABY = [
  '수유·수면·기저귀를 한 화면에서 기록하고 볼 수 있어요.', '아기 하루를 부부가 같이 기록할 수 있어요.',
  '성장 기록이 그래프로 자동 정리돼요.', '예방접종 일정을 개월 수 기준으로 알려드려요.',
  '밤중 수유도 버튼 하나로 남길 수 있어요.', '아기 사진과 그날의 기록이 함께 쌓여요.',
  '오늘 아기가 어땠는지 한 줄이면 충분해요.', '월령별로 지금 무엇이 정상인지 정리해드려요.',
];
const BODY1_PREG = [
  '예정일만 넣어두면 오늘이 몇 주 며칠인지 앱이 매일 세어드려요.', '주차마다 몸의 변화도, 챙길 것도 달라져요.',
  '임신 주차별로 지금 무엇이 정상 범위인지 정리해드려요.', '이번 주 아기가 얼마나 컸는지 그림과 함께 보여드려요.',
  '검사와 병원 일정을 주차 기준으로 미리 알려드려요.', '지금 시기에 흔한 증상과 조심할 신호를 구분해드려요.',
  '예정일 기준으로 오늘 챙길 것을 하나씩 알려드려요.', '매일 아침 이번 주 아기와 내 몸 소식을 보내드려요.',
];
const BODY2 = [
  '설치하고 예정일만 넣으면 바로 시작돼요.', '광고 없이 필요한 것만 보여드려요.',
  '부부가 같이 쓸 수 있어요.', '기록은 기기에 안전하게 남아요.',
  '같은 시기를 지나는 분들 이야기도 볼 수 있어요.', '무료로 쓸 수 있어요.',
  '알림은 필요한 것만 골라서 받을 수 있어요.', '쓰던 기록은 언제든 내려받을 수 있어요.',
];
const BTN = [
  '베이비빌리 앱 열어보기', '앱에서 바로 시작하기', '베이비빌리 앱 받기', '앱에서 확인해보기',
  '무료로 시작하기', '베이비빌리 앱 보러가기', '앱에서 기록 시작하기', '앱 설치하고 시작하기',
];

function h(s: string) { let n = 0; for (let i = 0; i < s.length; i++) n = (n * 31 + s.charCodeAt(i)) >>> 0; return n; }
const pick = (pool: string[], salt: string) => pool[h(slug + salt) % pool.length];

const isPreg = pillar === 'pregnancy';
let topic = (title || '').split(/[—–|,·]/)[0].trim();
if (topic.length > 28) topic = topic.split(/\s+/).slice(0, 4).join(' ');

const head = pick(isPreg ? HEAD_PREG : HEAD_BABY, 'h').replace('{T}', topic);
const body = pick(isPreg ? BODY1_PREG : BODY1_BABY, 'b1') + ' ' + pick(BODY2, 'b2');
const btn = pick(BTN, 'c');
---
<div class="vb-app-cta">
  <p class="vb-app-cta-t">📱 {head}</p>
  <p class="vb-app-cta-d">{body}</p>
  <a href={APP_LINK} target="_blank" rel="noopener">{btn} →</a>
</div>

<style>
  .vb-app-cta {
    background: linear-gradient(135deg, #2D7CD2, #4a97e6);
    border-radius: 12px; padding: 24px 22px; margin: 28px 0;
    text-align: center; box-shadow: 0 4px 18px rgba(45, 124, 210, .22);
  }
  .vb-app-cta-t { font-size: 1.02rem; font-weight: 800; color: #fff; margin: 0 0 8px; line-height: 1.5; }
  .vb-app-cta-d { font-size: .92rem; color: #fff; opacity: .95; line-height: 1.65; margin: 0 0 16px; }
  .vb-app-cta a {
    display: inline-block; background: #fff; color: #2D7CD2; font-weight: 700;
    padding: 11px 26px; border-radius: 16px; font-size: .94rem; text-decoration: none;
  }
</style>
